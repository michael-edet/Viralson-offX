<!-- Page Header -->
<section class="page-header">
    <div class="container">
        <span class="post-category" style="background:#e8eaf6; color:#3f51b5; margin-bottom: 0.8rem;">Voices & Discussions</span>
        <h1>Community Hub</h1>
        <p>A vibrant, moderated space where readers, creators, and experts exchange perspectives on modern culture, technology, and society.</p>
