<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default(site.name + " | " + site.tagline) }}</title>
    <meta name="description" content="{{ description | default(site.description) }}">
    
    <!-- OpenGraph Metadata -->
    <meta property="og:title" content="{{ title | default(site.name + ' | ' + site.tagline) }}">
    <meta property="og:description" content="{{ description | default(site.description) }}">
    <meta property="og:type" content="{{ ogType | default('website') }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% if image %}
    <meta property="og:image" content="{{ image }}">
    {% endif %}

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Master Stylesheet -->
    <link rel="stylesheet" href="/Assets/CD/CSS/index.css">

    <!-- Google AdSense Official Script -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.googleAdSense.clientId | default('ca-pub-9481237418920194') }}" crossorigin="anonymous"></script>

    <!-- Theme Initialization to prevent FOUC -->
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('viralson_theme');
                if (savedTheme) {
                    document.documentElement.setAttribute('data-theme', savedTheme);
                } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                }
            } catch (e) {}
        })();
    </script>
</head>
<body class="{% if isPost or ogType == 'article' %}post-detail-page{% endif %}">
    <!-- Global Reusable Page Loader -->
    {% include "pageloader.njk" %}

    <!-- Dynamic Header -->
    {% include "header.njk" %}

    <!-- Top Leaderboard Google Ads Scene (On Every Page) -->
    {% if not hideTopAd and page.url != '/admin/' %}
    <div class="container ad-leaderboard-container">
        {% set adType = "leaderboard" %}
        {% include "google-ad.njk" %}
    </div>
    {% endif %}

    <!-- Main Content Area -->
    <main>
        {{ content | safe }}
    </main>

    <!-- Pre-Footer Billboard Google Ads Scene (On Every Page) -->
    {% if not hideBottomAd and page.url != '/admin/' %}
    <div class="container ad-billboard-container">
        {% set adType = "billboard" %}
        {% include "google-ad.njk" %}
    </div>
    {% endif %}

    <!-- Dynamic Footer -->
    {% include "footer.njk" %}

    <!-- Sitewide Newsletter Popup Modal -->
    {% include "newsletter-modal.njk" %}

    <!-- Sticky Bottom Viewport Floating Google Ad Anchor -->
    {% if not hideAnchorAd and page.url != '/admin/' %}
        {% set adType = "anchor" %}
        {% include "google-ad.njk" %}
    {% endif %}

    <!-- Safe Google AdSense & Anchor Control Script -->
    <script>
        (function() {
            // Dismiss anchor ad
            window.dismissAnchorAd = function() {
                const anchor = document.getElementById('googleAdAnchor');
                if (anchor) {
                    anchor.classList.add('hidden');
                    sessionStorage.setItem('viralson_anchor_dismissed', 'true');
                }
            };

            // Check if dismissed in this session
            if (sessionStorage.getItem('viralson_anchor_dismissed') === 'true') {
                const anchor = document.getElementById('googleAdAnchor');
                if (anchor) anchor.classList.add('hidden');
            }

            // Safe push for Google AdSense slots without breaking if adblocker is present
            try {
                const adSlots = document.querySelectorAll('.adsbygoogle');
                if (adSlots.length > 0 && window.adsbygoogle) {
                    adSlots.forEach(() => {
                        try {
                            (window.adsbygoogle = window.adsbygoogle || []).push({});
                        } catch(e) {}
                    });
                }
            } catch(e) {}
        })();
    </script>
</body>
</html>
