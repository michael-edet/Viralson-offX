---
layout: layouts/base.njk
---

{% if showHeader != false %}
<section class="page-header">
    <div class="container">
        <h1>{{ title }}</h1>
        {% if description %}
        <p>{{ description }}</p>
        {% endif %}
    </div>
</section>
{% endif %}

<div class="container" style="margin-bottom: 4rem;">
    {{ content | safe }}
</div>
