            },
            audiomack: {
                title: 'Audiomack Stream Widget',
                html: '<div style="padding: 1.5rem; background: #1a1a1a; min-height: 320px; display: flex; flex-direction: column; justify-content: center; align-items: center; color: #fff; text-align: center;"><i class="fas fa-headphones" style="font-size: 3rem; color: #ffa200; margin-bottom: 1rem;"></i><h3 style="margin-bottom: 0.5rem; color: #ffffff;">Stream "Midnight Whispers" on Audiomack</h3><p style="color: #aaa; margin-bottom: 1.5rem; max-width: 480px;">Stream high-bitrate audio lossless master directly through the verified Audiomack player.</p><audio controls style="width: 100%; max-width: 500px; margin-bottom: 1.5rem;"><source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">Your browser does not support audio element.</audio><a href="https://audiomack.com" target="_blank" rel="noopener noreferrer" class="btn" style="background: #ffa200; color: #000 !important; font-weight: 700;"><i class="fas fa-external-link-alt"></i> Open in Audiomack App</a></div>'
            }
        };

        const container = document.getElementById('mediaPlayerAutomationContainer');
        const tabBtns = document.querySelectorAll('.media-tab-btn');

        function loadPlatformWidget(platformKey) {
            const platform = platforms[platformKey] || platforms.youtube;
            if (!container) return;

            // Update active button state
            tabBtns.forEach(btn => {
                if (btn.getAttribute('data-platform') === platformKey) {
                    btn.classList.add('active');
                    btn.style.background = 'var(--primary-blue)';
                    btn.style.color = '#ffffff';
                    btn.style.borderColor = 'var(--primary-blue)';
                } else {
                    btn.classList.remove('active');
                    btn.style.background = 'var(--surface-bg)';
                    btn.style.color = 'var(--text-dark)';
                    btn.style.borderColor = 'var(--border-color)';
                }
            });

            // Smooth transition
            container.style.opacity = '0.5';
            setTimeout(() => {
                container.innerHTML = platform.html;
                container.style.opacity = '1';
            }, 120);
        }

        // Initialize with default platform (YouTube)
        loadPlatformWidget('youtube');

        // Tab click event listeners
        tabBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const platform = this.getAttribute('data-platform');
                loadPlatformWidget(platform);
            });
        });
    })();
</script>
