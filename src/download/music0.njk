        const container = document.getElementById('cinemaPlayerAutomationContainer');
        const tabBtns = document.querySelectorAll('.media-tab-btn');

        function loadCinemaWidget(platformKey) {
            const platform = platforms[platformKey] || platforms.youtube;
            if (!container) return;

            tabBtns.forEach(btn => {
                if (btn.getAttribute('data-platform') === platformKey) {
                    btn.classList.add('active');
                    btn.style.background = 'var(--purple)';
                    btn.style.color = '#ffffff';
                    btn.style.borderColor = 'var(--purple)';
                } else {
                    btn.classList.remove('active');
                    btn.style.background = 'var(--surface-bg)';
                    btn.style.color = 'var(--text-dark)';
                    btn.style.borderColor = 'var(--border-color)';
                }
            });

            container.style.opacity = '0.5';
            setTimeout(() => {
                container.innerHTML = platform.html;
                container.style.opacity = '1';
            }, 120);
        }

        loadCinemaWidget('youtube');

        tabBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                const platform = this.getAttribute('data-platform');
                loadCinemaWidget(platform);
            });
        });
    })();
</script>
